.git
.agents
.codex
.knossos
.superpowers
docs/superpowers
coverage
vendor
node_modules
workers/php/vendor
workers/typescript/node_modules
workers/rust/target
workers/rust/bin
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Local run output that .gitignore already keeps out of the repository. It has
# to be kept out of the build context too, or a developer's leftovers change
# what the image contains and the container stops answering the same question
# CI does. cargo-mutants is the one that bites: it writes JSON that prettier
# then reports as unformatted, so `tools/quality-container` fails for anyone
# who has run mutation testing and passes for everyone else.
.env
.phpunit.cache
.php-cs-fixer.cache
.mypy_cache
.ruff_cache
__pycache__
# The bare names above match only at the root of the context. Tools write
# these caches next to the code they ran on, so they are excluded at any depth.
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/__pycache__
*.pyc
workers/rust/mutants.out
chaos-infection-log.json
.chaos-mcp
infection.args.log
infection.out.log
.audit-patches
docs/audits
.plugin
.claude/settings.local.json
.claude-plugin/types
tools/capture/out
# The documentation site's own dependencies and build output. The quality
# stage copies website/ so its scripts are linted; these must not come along.
website/node_modules
website/.vitepress/dist
website/.vitepress/cache

# What tests/theseus/prepare.sh downloads, builds and renders for the lifecycle
# rehearsal: two release tarballs and the recipe written from its template.
tests/theseus/artifacts
tests/theseus/theseus.toml
tests/theseus/.theseus-runs
