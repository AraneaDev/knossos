parameters:
    level: 5
    paths:
        - src
        - bin
        - workers/php/src
        - tests/phpunit
    # The global assertion helpers the PHPUnit bootstrap loads, and the tools
    # library a test requires at runtime.
    bootstrapFiles:
        - tests/phpunit/Support/Assertions.php
    scanFiles:
        - tools/lib/dependency-fanout.php
        - tools/lib/php-function-metrics.php
    excludePaths:
        analyse:
            - bin/knossos
    tmpDir: /tmp/knossos-phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
