{
  "name": "knossos-quality",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "php tools/lint-files.php --run=js -- eslint --max-warnings 0",
    "format:check": "prettier --check \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "format:write": "prettier --write \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "lint:md": "node tools/lint-md.mjs",
    "test:mod": "vitest run --config vitest.config.mjs",
    "typecheck:mod": "tsc -p hooks/tsconfig.json && tsc -p hooks/tsconfig.spec.json && tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@xterm/xterm": "6.0.0",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "markdownlint": "0.42.0",
    "prettier": "3.9.10",
    "puppeteer-core": "25.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
