<?xml version="1.0" encoding="UTF-8"?>
<!--
  One PHP suite, run by `composer test` and by Infection. It covers all of
  tests/phpunit, including the MCP transport/concurrency/HTTP tests. There is
  deliberately no default/unit split: the previous two-suite layout let a
  narrowed testsuite selection silently skip every test under tests/phpunit/Mcp
  (the most integration-heavy tests in the tree), which hid real gaps.

  For the same reason no group is excluded here. `slow` marks each test over
  five seconds (tools/tag-slow-tests.php checks and writes it) and
  `test-fidelity` the test-fidelity suites; a local loop selects with them,
  as docs/contribute/quality.md describes, while `composer test`, CI and
  Infection run every test.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/phpunit/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="knossos">
            <directory>tests/phpunit</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="memory_limit" value="1G"/>
    </php>
    <extensions>
        <!-- Fails the run when a test leaves anything in the run's temp directory (see tests/phpunit/bootstrap.php). -->
        <bootstrap class="Knossos\Tests\Phpunit\Support\TempRootGuard"/>
    </extensions>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
