{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knossos.local/schemas/scanner/v1/contribution.schema.json",
  "title": "Knossos scan contribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner_key", "nodes", "edges", "diagnostics"],
  "properties": {
    "owner_key": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "factBase": {
      "type": "object",
      "required": ["origin", "confidence", "evidence", "attributes"],
      "properties": {
        "origin": {
          "enum": [
            "ast",
            "composer",
            "config",
            "framework_convention",
            "derived",
            "enricher"
          ]
        },
        "confidence": { "enum": ["certain", "probable", "possible"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "attributes": {
          "type": "object",
          "properties": {
            "exports": {
              "description": "A module node: every name it exports, sorted ('default' for the default export). Sent only when the worker could read the whole list.",
              "type": "array",
              "items": { "type": "string" }
            },
            "exports_open": {
              "description": "True when exports cannot be complete (an `export *` from a module that does not resolve, an `export =`).",
              "type": "boolean"
            },
            "member_names": {
              "description": "A class or interface node: every member it declares or inherits, sorted, static members included.",
              "type": "array",
              "items": { "type": "string" }
            },
            "foreign_writes": {
              "description": "A Python module node: each name the file writes on a project module or class that another file declares (`config.FLAG = 1`, `Settings.debug = True`, a `setattr`), sorted; `target` is that module's or class's reference and `name` the name written, absent for a `setattr` whose name no literal spells. A reader opens the target's list on any of them. The writer's reads name the target's file.",
              "type": "array",
              "items": {
                "type": "object",
                "required": ["target"],
                "properties": {
                  "target": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 }
                }
              }
            },
            "member_names_open": {
              "description": "True when members cannot be complete (a base type that does not resolve, an index signature).",
              "type": "boolean"
            },
            "private_names": {
              "description": "A class node: those of its member_names that are ECMAScript private members (`#name`), sorted; a member named by the string '#name' is public and not listed. Sent only when there is one.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "fields": { "$ref": "#/$defs/fieldList" },
            "fields_open": {
              "description": "True when a wire name may differ from a field's name or a field may come from elsewhere (a base outside the scan, an intersection or spread that does not resolve, a decorator or attribute that renames, flatten, an alias generator).",
              "type": "boolean"
            },
            "fields_truncated": {
              "description": "True when fields was cut at 64 entries. A truncated list is never judged.",
              "type": "boolean"
            },
            "cases": { "$ref": "#/$defs/caseList" },
            "cases_truncated": {
              "description": "True when cases was cut at 64 entries. A truncated list is never judged.",
              "type": "boolean"
            },
            "overloaded": {
              "description": "A function or method node declared with overload signatures: its signature attribute is the first one only.",
              "type": "boolean"
            }
          }
        }
      }
    },
    "node": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_id",
            "kind",
            "canonical_name",
            "display_name",
            "origin",
            "confidence",
            "evidence",
            "attributes"
          ],
          "properties": {
            "local_id": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "canonical_name": { "type": "string", "minLength": 1 },
            "display_name": { "type": "string", "minLength": 1 },
            "origin": true,
            "confidence": true,
            "evidence": true,
            "attributes": true
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "route" } }
          },
          "then": {
            "properties": {
              "attributes": { "$ref": "#/$defs/routeAttributes" }
            }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "test_double" } }
          },
          "then": {
            "properties": {
              "attributes": { "$ref": "#/$defs/testDoubleAttributes" }
            }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "test_case" } }
          },
          "then": {
            "properties": {
              "attributes": { "$ref": "#/$defs/testCaseAttributes" }
            }
          }
        }
      ]
    },
    "fieldList": {
      "description": "A class, interface, trait, type_alias or Rust struct node: the fields a deserialiser fills, sorted by name, at most 64 (see fields_truncated). Sent only when the worker could read them; see fields_open.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "line"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "description": "The field's type as the source writes it, but a PHP class name fully qualified; absent when it writes none.",
            "type": "string"
          },
          "required": {
            "description": "Whether a deserialiser needs the key.",
            "type": "boolean"
          },
          "line": { "type": "integer", "minimum": 1 },
          "visibility": {
            "description": "The field's declared visibility; absent means public. A non-public field is a known key but never required of a fixture.",
            "enum": ["public", "protected", "private"]
          }
        }
      }
    },
    "caseList": {
      "description": "The node that declares an enum (enum for TypeScript and PHP, class for Rust and Python): its cases, sorted by name, at most 64 (see cases_truncated).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": {
            "description": "The backing literal as text. Sent for every case or for none.",
            "type": "string"
          }
        }
      }
    },
    "routeAttributes": {
      "description": "What every route node carries, whichever worker emits it: its framework, the upper-case methods it answers (ANY for every method) and its path as declared.",
      "type": "object",
      "required": ["framework", "methods", "path"],
      "properties": {
        "framework": { "type": "string", "minLength": 1 },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]+$" }
        },
        "path": { "type": "string" }
      }
    },
    "testDoubleAttributes": {
      "description": "What a test_double node carries: the mocking framework, the pattern that made the double, what it replaces, whether it is an automock, how often its file calls it, the test_case it belongs to and the members the test configures; optionally also_implements, the further types it is made to be, or also_implements_open when the worker could not name them all. Optional: a worker that does not read tests emits none of these nodes.",
      "type": "object",
      "required": [
        "framework",
        "pattern",
        "target",
        "automock",
        "invocations",
        "members"
      ],
      "properties": {
        "framework": {
          "enum": [
            "vitest",
            "jest",
            "phpunit",
            "mockery",
            "pest",
            "prophecy",
            "unittest",
            "pytest-mock",
            "pytest",
            "mockall",
            "faux",
            "mry",
            "mockers",
            "mockiato",
            "mocktopus",
            "mock_derive",
            "galvanic",
            "hand-written"
          ]
        },
        "pattern": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "module",
                "class",
                "instance-member",
                "global",
                "unknown"
              ]
            },
            "specifier": { "type": "string" },
            "export": { "type": "string" },
            "member": { "type": "string" }
          }
        },
        "automock": { "type": "boolean" },
        "invocations": { "type": "integer", "minimum": 0 },
        "allows_protected": { "type": "boolean" },
        "compile_checked": {
          "type": "boolean",
          "description": "true on a Rust double: a reader must not judge drift on it, the language's compiler rejects any mismatch."
        },
        "also_implements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "also_implements_open": { "type": "boolean" },
        "test_case": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/stubbedMember" }
        }
      }
    },
    "stubbedMember": {
      "type": "object",
      "required": ["name", "line", "api", "returns"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "api": {
          "enum": [
            "spyOn",
            "mockFactoryKey",
            "objectLiteralKey",
            "instance-member",
            "method",
            "shouldReceive",
            "configured",
            "partial",
            "addMethods",
            "prophecy",
            "shouldHaveReceived",
            "patch",
            "patch.object",
            "patch.multiple",
            "patch.dict",
            "spy",
            "setattr",
            "attribute",
            "assigned",
            "expect",
            "context",
            "when",
            "mock",
            "mock_fn",
            "given",
            "impl",
            "unknown"
          ]
        },
        "params": { "type": "array" },
        "called_with": {
          "type": "array",
          "items": { "$ref": "#/$defs/callMatcher" }
        },
        "returns": {
          "type": "array",
          "items": { "$ref": "#/$defs/pinnedValue" }
        }
      }
    },
    "pinnedValue": {
      "type": "object",
      "required": ["api", "line", "once", "assignable", "typed"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "once": { "type": "boolean" },
        "assignable": { "enum": [true, false, "unknown"] },
        "typed": { "type": "boolean" },
        "type": { "type": "string", "minLength": 1 },
        "type_ancestors": {
          "description": "For a pinned class built into the language, every class and interface it extends or implements, fully qualified, as the worker's runtime reflects them (the PHP worker's Reflection on PHP's own classes).",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "callMatcher": {
      "type": "object",
      "required": ["api", "line", "count", "spread"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "spread": { "type": "boolean" },
        "keywords": {
          "description": "The keyword names the matcher lists, in source order (Python); `count` holds the positional arguments and the keywords together.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "negated": {
          "description": "True when the matcher is called through `.not` (TypeScript): one that lists fewer arguments than the member requires cannot fail.",
          "type": "boolean"
        }
      }
    },
    "testCaseAttributes": {
      "description": "What a test_case node carries: its name, how many production calls it makes, the production modules those calls land in, whether it expects a panic or to fail and its assertions with the source of each operand.",
      "type": "object",
      "required": ["name", "production_calls", "subjects", "assertions"],
      "properties": {
        "name": { "type": "string" },
        "production_calls": { "type": "integer", "minimum": 0 },
        "subjects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "should_panic": { "type": "boolean" },
        "fails": {
          "description": "True for a test the runner expects to fail (Vitest's `it.fails`): it passes only when an assertion fails, so no tautology is judged in it.",
          "type": "boolean"
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/testAssertion" }
        }
      }
    },
    "testAssertion": {
      "type": "object",
      "required": ["api", "line", "operands"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "negated": { "type": "boolean" },
        "operands": {
          "type": "array",
          "items": { "$ref": "#/$defs/testOperand" }
        }
      }
    },
    "testOperand": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "enum": [
            "mock-config",
            "mock-call",
            "production",
            "literal",
            "parameter",
            "unknown"
          ]
        },
        "text": { "type": "string" },
        "value": { "type": "string" },
        "double": { "type": "string" },
        "unconfigured_spy": { "type": "boolean" }
      }
    },
    "edge": {
      "allOf": [
        { "$ref": "#/$defs/factBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "target",
            "origin",
            "confidence",
            "evidence",
            "attributes"
          ],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "origin": true,
            "confidence": true,
            "evidence": true,
            "attributes": true
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "calls" } } },
          "then": { "properties": { "attributes": { "$ref": "#/$defs/callsAttributes" } } }
        }
      ]
    },
    "callsAttributes": {
      "description": "What a calls edge may carry beyond the attributes every edge may: `callable`, true when the code hands the target method to a call as a callable argument (PHP's `[$repo, 'save']`, `'App\\Repo::save'` given to a function that takes a callback, or `$repo->save(...)`) rather than calling it there, so it may be called with more arguments than it takes; readers count it from production code only.",
      "type": "object",
      "properties": {
        "callable": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
