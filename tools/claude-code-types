#!/bin/sh
# Regenerates tools/claude-code-api: the Claude Code API declarations the
# staged register.tsx type-check in tools/quality reads.
#
# Usage: tools/claude-code-types
#
# The CLI does not ship these declarations. It builds them at run time from its
# own tool schemas and writes them beside a mod each time a session loads it,
# as .claude-plugin/types/claude-code/index.d.ts and claude-code-tools/. So
# this installs the version the Dockerfile pins into a temporary prefix,
# stages the plugin the way an install does, and starts one interactive
# session with the staged plugin loaded, under `script` for a terminal. Since
# 2.1.303 a headless `claude -p` run no longer writes them; an interactive one
# does, as soon as it loads the mod. The session has its own config directory,
# with onboarding and the folder's trust already answered, and an API key that
# is not valid, so it never reaches the API, your account or your own Claude
# Code configuration. It is stopped once the declarations are on disk.
#
# The version is recorded in tools/claude-code-api/VERSION, and the static
# lane (tools/claude-code-types-check.php) refuses a copy whose version is not
# the one the Dockerfile pins. Run this after moving that pin. It needs npm,
# node and the network.
set -eu

root=$(unset CDPATH; cd -- "$(dirname -- "$0")/.." && pwd)
version=$(sed -n 's/.*@anthropic-ai\/claude-code@\([0-9][0-9.]*\).*/\1/p' "$root/Dockerfile" | head -n 1)
if [ -z "$version" ]; then
    echo "claude-code-types: the Dockerfile pins no @anthropic-ai/claude-code version" >&2
    exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
mkdir -p "$work/prefix" "$work/home" "$work/config"
npm install --prefix "$work/prefix" "@anthropic-ai/claude-code@$version" --no-audit --no-fund >/dev/null
# The package puts its native binary in place from a postinstall script that
# npm does not run for it, as the Dockerfile notes.
node "$work/prefix/node_modules/@anthropic-ai/claude-code/install.cjs" >/dev/null
command -v script >/dev/null 2>&1 || { echo 'claude-code-types: needs script(1) from util-linux for a terminal' >&2; exit 1; }
claude="$work/prefix/node_modules/.bin/claude"
php "$root/bin/knossos" install-agent-plugin --out="$work/plugin" --data=/nonexistent >/dev/null

# Onboarding, the folder's trust and the key's approval are answered up front,
# or the session stops at a prompt before it loads the plugin. The approval
# names the key by its last 20 characters.
key=sk-ant-invalid-key-for-type-generation
printf '{"hasCompletedOnboarding":true,"theme":"dark","customApiKeyResponses":{"approved":["%s"],"rejected":[]},"projects":{"%s":{"hasTrustDialogAccepted":true,"hasCompletedProjectOnboarding":true}}}\n' \
    "$(printf '%s' "$key" | tail -c 20)" "$work" > "$work/config/.claude.json"
(cd "$work" && env -i PATH="$PATH" HOME="$work/home" CLAUDE_CONFIG_DIR="$work/config" ANTHROPIC_API_KEY="$key" TERM=xterm \
    script -qec "$claude --plugin-dir $work/plugin" /dev/null >/dev/null 2>&1 </dev/null) &
session=$!

written="$work/plugin/.claude-plugin/types"
waited=0
until [ -s "$written/claude-code/index.d.ts" ] && [ -s "$written/claude-code-tools/index.d.ts" ] || [ "$waited" -ge 120 ]; do
    sleep 1
    waited=$((waited + 1))
done
# A moment longer, so a file still being written is complete.
sleep 2
pkill -P "$session" >/dev/null 2>&1 || true
kill "$session" >/dev/null 2>&1 || true
pkill -f -- "--plugin-dir $work/plugin" >/dev/null 2>&1 || true
wait "$session" 2>/dev/null || true

first=$(head -n 1 "$written/claude-code/index.d.ts" 2>/dev/null || true)
if [ "$first" != "// Written by Claude Code $version." ] || [ ! -f "$written/claude-code-tools/index.d.ts" ]; then
    echo "claude-code-types: Claude Code $version did not write its declarations into the staged plugin" >&2
    exit 1
fi

out="$root/tools/claude-code-api"
rm -rf "$out/claude-code" "$out/claude-code-tools"
mkdir -p "$out/claude-code" "$out/claude-code-tools"
cp "$written/claude-code/index.d.ts" "$out/claude-code/index.d.ts"
cp "$written/claude-code-tools/index.d.ts" "$out/claude-code-tools/index.d.ts"
printf '%s\n' "$version" > "$out/VERSION"
printf 'claude-code-types: wrote the declarations of Claude Code %s to tools/claude-code-api\n' "$version"
