#!/bin/sh
# The knossos launcher that install.sh writes to the bin directory.
#
# install.sh copies this file and replaces the value on the INSTALL_DIR line
# with the directory it installed into: the one holding install.json (and, in
# native mode, versions/ and current). self-update rewrites it the same way
# from the new release. It never searches PATH for itself.
#
# Native mode starts no process besides the final exec: the mode is read from
# install.json with shell pattern matching. `serve` is the one exception: it
# runs the release's mcp-serve wrapper, which starts the server and logs what
# happens to it.
#
# Container mode runs the command in a container of the image install.json
# names, one long-lived container per project root, and needs neither PHP nor
# Node nor Python on the host. See the container section below.
#
# Two different directories, kept apart on purpose:
#   - the install directory, baked in below, is where the release lives. It is
#     the only thing used to find install.json and current.
#   - KNOSSOS_DATA_DIR is where the graph lives. A caller's value is passed on
#     untouched; without one it defaults to the install directory. It never
#     decides which release runs.
#
# KNOSSOS_INSTALL_DIR replaces the baked-in install directory. It exists for
# the installer's own pre-switch check and for tests, not for everyday use.
#
# Threat note (container mode). A scanned project is untrusted input, so the
# code inside a container is treated as hostile. Each container gets:
#   - the project root, READ-ONLY: nothing a container does can plant a file
#     in it that a tool on the host would later run (a git hook, an editor
#     task, an agent setting);
#   - the graph directory, read-write, as its own mount: the one place a
#     container can write;
#   - the install directory, READ-ONLY, on top of the graph mount;
#   - the directory of a roots file the caller named elsewhere, read-only.
# This launcher runs on the host, as you, so nothing it reads or runs may be
# something a container could have written:
#   - The install directory holds everything the host trusts: install.json,
#     plugin/, the update helper, the update check, the lock, containers/ and
#     roots.json, the allow-list. Neither it nor its parent can be renamed from
#     inside: both are mount points there.
#   - No mount a container can write may contain or be the graph directory,
#     the install directory or the directory holding this launcher, and the
#     project root may not either. The launcher refuses such a layout in one
#     line, and so does the installer.
#   - The allow-list the project root is chosen from is the one in the install
#     directory, or a file the caller named outside every directory a
#     container can write and outside the project. The same file is handed to
#     the container, read-only, so the server there enforces the same list.
#     allow-root, claim and move-project change it here, on the host. Nothing
#     read from it is ever run or expanded unquoted.
#   - A file a command is told to write is written into a scratch directory in
#     the graph directory and moved to the path named by the host, which never
#     follows a link there; a file it is told to read from outside every mount
#     is copied in. See FILE_ROLES below.
#   - The installer bakes the device and inode numbers of the install
#     directory into this file, and every call compares them before it reads
#     anything there, so a directory put in its place by anyone is refused.
#   - The image and the runtime come from install.json, which no container can
#     write. KNOSSOS_* variables and PATH are your own environment.

# No pathname expansion anywhere in this script: it handles paths it did not
# choose (a project called `notes?` or `Project [old]`, a roots entry written
# by hand), and an unquoted one must never turn into the names of other
# directories that then get mounted.
set -f

INSTALL_DIR='__KNOSSOS_INSTALL_DIR__'
# Container mode: the device and inode numbers of the install directory when
# the installer made it, baked in beside the path. Native mode leaves the
# placeholder, and then nothing is compared.
INSTALL_PIN='__KNOSSOS_INSTALL_PIN__'

BAKED_INSTALL_DIR=$INSTALL_DIR
INSTALL_DIR="${KNOSSOS_INSTALL_DIR:-$INSTALL_DIR}"
case $INSTALL_PIN in __*__) INSTALL_PIN='' ;; esac

# dir_id DIR: "<device>:<inode>" of DIR itself (a symlink there is not
# followed), ":<inode>" where only the inode can be read, or nothing.
dir_id() {
    # GNU coreutils (Linux) and BusyBox: stat -c.
    id=$(stat -c '%d:%i' -- "$1" 2>/dev/null) || id=''
    case $id in [0-9]*:[0-9]*) case $id in *[!0-9:]*) ;; *) printf '%s' "$id"; return 0 ;; esac ;; esac
    # BSD stat (macOS, FreeBSD, OpenBSD, NetBSD): stat -f, where %d is the
    # device and %i the inode, as with -c above.
    id=$(stat -f '%d:%i' -- "$1" 2>/dev/null) || id=''
    case $id in [0-9]*:[0-9]*) case $id in *[!0-9:]*) ;; *) printf '%s' "$id"; return 0 ;; esac ;; esac
    # Neither (a system without a stat command): POSIX ls -di gives the inode
    # alone; the device is left out of the comparison.
    id=$(ls -di -- "$1" 2>/dev/null) || id=''
    id=${id#"${id%%[! ]*}"}
    id=${id%%[! 0-9]*}
    id=${id%% *}
    case $id in '' | *[!0-9]*) return 1 ;; esac
    printf ':%s' "$id"
}

# The install directory must be the one the installer created, checked before
# anything in it is read: a directory put in its place, by anyone, is never
# trusted. Only for the baked-in directory; KNOSSOS_INSTALL_DIR is your own
# setting, for the installer's check and for tests.
if [ -n "$INSTALL_PIN" ] && [ "$INSTALL_DIR" = "$BAKED_INSTALL_DIR" ]; then
    now=$(dir_id "$INSTALL_DIR") || now=''
    case $now in
        '') pinned=no ;;
        :*) if [ "${INSTALL_PIN#*:}" = "${now#:}" ]; then pinned=yes; else pinned=no; fi ;;
        *)
            case $INSTALL_PIN in
                :*) if [ "${INSTALL_PIN#:}" = "${now#*:}" ]; then pinned=yes; else pinned=no; fi ;;
                *) if [ "$INSTALL_PIN" = "$now" ]; then pinned=yes; else pinned=no; fi ;;
            esac
            ;;
    esac
    if [ "$pinned" = no ]; then
        printf 'knossos: the install directory %s is not the one the installer created; re-run the installer.\n' "$INSTALL_DIR" >&2
        exit 1
    fi
fi

# install.json, joined into one line: pretty-printed or not, with or without a
# space after the colon. A missing file means native. It is read through a
# symlink, as every native release has read it; container mode refuses a
# symlinked one below, before it uses anything from it.
record=''
if [ -r "$INSTALL_DIR/install.json" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        record="$record$line"
    done < "$INSTALL_DIR/install.json"
fi

# field NAME: sets `value` to the string value of a top-level "NAME" in
# install.json, or to nothing for a missing key, null or a value that is not a
# plain string. No subshell, so native mode still starts no process before its
# exec. The values read this way (mode, image, runtime) never hold a quote or
# a backslash, so no escape is decoded.
field() {
    value=''
    case $record in
        *"\"$1\""*:*) ;;
        *) return 0 ;;
    esac
    rest=${record#*"\"$1\""}
    while :; do
        case $rest in
            ' '* | '	'* | :*) rest=${rest#?} ;;
            *) break ;;
        esac
    done
    case $rest in
        '"'*)
            rest=${rest#?}
            value=${rest%%\"*}
            ;;
    esac
}

mode=native
if [ -n "$record" ]; then
    case $record in
        *'"mode"'*:*)
            field mode
            case $value in
                native) mode=native ;;
                container) mode=container ;;
                *) mode=unknown ;;
            esac
            ;;
    esac
fi

case $mode in
    native)
        # The graph defaults to the install directory, as it always has.
        KNOSSOS_DATA_DIR="${KNOSSOS_DATA_DIR:-$INSTALL_DIR}"
        KNOSSOS_ROOTS_FILE="${KNOSSOS_ROOTS_FILE:-$KNOSSOS_DATA_DIR/roots.json}"
        export KNOSSOS_DATA_DIR KNOSSOS_ROOTS_FILE
        if [ ! -x "$INSTALL_DIR/current/bin/knossos" ]; then
            echo "knossos: no installed release found in $INSTALL_DIR; re-run the installer to repair it." >&2
            exit 1
        fi
        # The MCP server goes through the release's mcp-serve wrapper, as a
        # checkout's registration does through tools/mcp-serve: it logs start,
        # signals, stderr and the exit status to $KNOSSOS_DATA_DIR/mcp-serve.log,
        # which is all there is to go on when a host only says "disconnected".
        if [ "${1-}" = serve ] && [ -x "$INSTALL_DIR/current/launcher/mcp-serve" ]; then
            shift
            exec "$INSTALL_DIR/current/launcher/mcp-serve" "$@"
        fi
        exec "$INSTALL_DIR/current/bin/knossos" "$@"
        ;;
    container) ;;
    *)
        echo "knossos: unreadable mode in $INSTALL_DIR/install.json; re-run the installer to repair it." >&2
        exit 1
        ;;
esac

# ---- container mode ----------------------------------------------------------
#
# One container per project root, started on the first call and reused by
# every call after it through `exec`. The project root (read-only), the data
# directory and the directory of the roots file are mounted at the SAME
# absolute paths, so a path means the same thing inside as outside and a
# project keeps the id a native install would give it. The container runs as the caller's
# user and group with HOME=/tmp and no network. None of those directories may
# be /, the home directory or a directory above it: the launcher refuses
# rather than hand a container the whole home directory.
#
# The install directory (<data dir>/install by default, baked in above) holds
# everything the host side trusts: install.json, plugin/, the update helper,
# update-check.json, the update lock and containers/. It is mounted into every
# container READ-ONLY, as one mount over the read-write data directory, so
# code in a container (a scanned project is untrusted input to the workers)
# can never create, replace or remove anything in it: no planted symlink can
# steer what the host later mounts or writes. The launcher still checks at
# every call that the directory and each entry it uses are no symlinks.
#
# Its entrypoint is tools/launcher/idle-stop, which exits (and so stops the
# container, which --rm then removes) once nothing has run in it for 30
# minutes: every call touches a marker file under <install dir>/containers.
# The image's health check is off for it: a probe every 30 seconds would only
# wake an idle container. The image is never pulled here (--pull=never): one
# that is gone from the host is reported, not fetched behind your back.
#
# The container's name is a hash of the install directory, the root, the data
# directory, the roots file and the image, so two installations never share a
# container, and after an update or a rollback the next call starts one from
# the image install.json now names instead of reusing an old one.
#
# `knossos stop [--all]` and `knossos self-update` are answered here, on the
# host: the code in the container can neither stop its own container nor
# replace its image.

die() {
    printf 'knossos: %s\n' "$1" >&2
    exit 1
}

# No release writes install.json as a symlink, and in container mode one is
# never used: refused before anything from it is.
[ ! -L "$INSTALL_DIR/install.json" ] || die "$INSTALL_DIR/install.json is a symlink; re-run the installer to repair the install directory $INSTALL_DIR."
field image
IMAGE=$value
field runtime
RUNTIME=${value:-docker}
case $RUNTIME in
    docker | podman) ;;
    *) die "unknown container runtime '$RUNTIME' in $INSTALL_DIR/install.json; re-run the installer to repair it." ;;
esac
[ -n "$IMAGE" ] || die "$INSTALL_DIR/install.json names no image; re-run the installer to repair it."
command -v "$RUNTIME" >/dev/null 2>&1 || die "$RUNTIME is not installed or not on PATH; this installation runs Knossos in a $RUNTIME container."

# Where the image keeps what the launcher runs.
IN_IMAGE=/opt/knossos
NEWLINE='
'

# A path's physical form, or nothing when it is not a directory that can be entered.
physical() { (CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P); }

# The host state directory must be exactly what the installer made: the
# baked-in path itself (no symlink anywhere in it), and real directories and
# files inside it. Anything else is not trusted.
untrusted() {
    die "$1; re-run the installer to repair the install directory $INSTALL_DIR."
}
# Every container install bakes in the pin checked at the top; a launcher
# without one was not written by the installer for this directory.
if [ -z "$INSTALL_PIN" ] && [ "$INSTALL_DIR" = "$BAKED_INSTALL_DIR" ]; then
    untrusted "this launcher carries no record of which directory the installer created"
fi
[ ! -L "$INSTALL_DIR" ] || untrusted "the install directory is a symlink"
INSTALL_REAL=$(physical "$INSTALL_DIR")
if [ -z "$INSTALL_REAL" ] || [ "$INSTALL_REAL" != "$INSTALL_DIR" ]; then untrusted "the install directory is not at its own physical path"; fi
for entry in plugin containers container-update update-check.json self-update.lock.d roots.json roots.json.lock.d; do
    [ ! -L "$INSTALL_DIR/$entry" ] || untrusted "$INSTALL_DIR/$entry is a symlink"
done
if [ ! -d "$INSTALL_DIR/containers" ] || [ ! -d "$INSTALL_DIR/plugin" ]; then untrusted "$INSTALL_DIR has no containers/ or plugin/ directory"; fi
# A container install keeps its install directory apart from the graph since
# before the first release that offered container mode, so a record without
# that layout was never written by a released version: it is refused, not
# migrated.
field layout
[ "$value" = separate ] || untrusted "this container install keeps its record where the graph is, a layout no release wrote"

# The directories holding this launcher, physical: the one it was run from and
# the one the installer wrote it to. A container that could write either could
# replace what the host runs next.
LAUNCHER_DIRS=$(physical "$(dirname -- "$0")")
field bin_dir
if [ -n "$value" ]; then
    bin_real=$(physical "$value")
    if [ -n "$bin_real" ] && [ "$bin_real" != "$LAUNCHER_DIRS" ]; then LAUNCHER_DIRS="$LAUNCHER_DIRS$NEWLINE$bin_real"; fi
fi

# The graph defaults to the directory around the install directory, the one
# the person picked with --data-dir: switching between native and container
# mode keeps the same graph.
KNOSSOS_DATA_DIR="${KNOSSOS_DATA_DIR:-$(dirname -- "$INSTALL_DIR")}"
# The allow-list is the one the host keeps in the install directory, which no
# container can write. `roots.json` in the graph directory (or in the data
# directory around the install directory) is what the plugin's hooks and the
# MCP registration name, and where a container install kept it before; it lies
# where every container can write, so that name stands for the host's list
# and the file there is never read. A caller's KNOSSOS_ROOTS_FILE anywhere
# else is checked below.
ROOTS_GIVEN=${KNOSSOS_ROOTS_FILE:-}
case $ROOTS_GIVEN in '' | "$(dirname -- "$INSTALL_DIR")/roots.json" | "${KNOSSOS_DATA_DIR%/}/roots.json") ROOTS_GIVEN='' ;; esac
KNOSSOS_ROOTS_FILE=${ROOTS_GIVEN:-$INSTALL_DIR/roots.json}
export KNOSSOS_DATA_DIR KNOSSOS_ROOTS_FILE

# inside PATH DIR: whether PATH is DIR or lies under it. Every path is under /.
inside() {
    [ "$2" = / ] && return 0
    case $1 in "$2" | "$2"/*) return 0 ;; esac
    return 1
}

# The first 12 hex digits of the SHA-256 of the argument.
hash12() {
    if command -v sha256sum >/dev/null 2>&1; then
        sum=$(printf '%s' "$1" | sha256sum)
    elif command -v shasum >/dev/null 2>&1; then
        sum=$(printf '%s' "$1" | shasum -a 256)
    else
        die 'sha256sum or shasum is required to name the container'
    fi
    printf '%s' "$sum" | cut -c 1-12
}

INSTALL_HASH=$(hash12 "$INSTALL_DIR")

# The roots the roots file lists, one per line. Both shapes the server reads
# ({"roots": [...]} and a bare [...]): every string that is not a key. A string
# with a \u escape cannot be compared byte for byte and is left out, which only
# means that root is not used to widen a mount.
roots() {
    [ -r "$KNOSSOS_ROOTS_FILE" ] || return 0
    awk '
        { text = text $0 "\n" }
        END {
            n = length(text); i = 1
            while (i <= n) {
                c = substr(text, i, 1)
                if (c != "\"") { i++; continue }
                value = ""; skip = 0; i++
                while (i <= n) {
                    c = substr(text, i, 1)
                    if (c == "\\") {
                        e = substr(text, i + 1, 1)
                        if (e == "u") { skip = 1; value = value "?" }
                        else if (e == "n" || e == "t" || e == "r" || e == "b" || e == "f") { skip = 1 }
                        else { value = value e }
                        i += 2; continue
                    }
                    if (c == "\"") break
                    value = value c; i++
                }
                i++
                j = i
                while (j <= n && substr(text, j, 1) ~ /[ \t\r\n]/) j++
                if (substr(text, j, 1) == ":") continue
                if (!skip && value != "") print value
            }
        }
    ' "$KNOSSOS_ROOTS_FILE" 2>/dev/null
}

# Whether a directory may be mounted: not /, not the home directory and not
# above it. Prints the reason when it may not. Given physical paths only.
too_wide() {
    if [ "$1" = / ]; then
        printf 'is the filesystem root'
        return 0
    fi
    if [ -n "$HOME_REAL" ] && inside "$HOME_REAL" "$1"; then
        if [ "$1" = "$HOME_REAL" ]; then printf 'is your home directory'; else printf 'contains your home directory'; fi
        return 0
    fi
    return 1
}

# The home directory, physical, or nothing when HOME does not name one. Only a
# start refuses without it (see below); stop and self-update mount nothing.
HOME_REAL=''
if [ -n "${HOME:-}" ] && [ -d "$HOME" ]; then HOME_REAL=$(physical "$HOME"); fi

# project_root DIR (physical): prints the project root, then on a second line
# the roots entry as written when it chose that root (empty otherwise). The
# root is the nearest ancestor of DIR (DIR itself included) that the roots
# file lists, else DIR. An entry counts only when it is an absolute path to an
# existing directory, and it is compared in its physical form, since that is
# what gets mounted. An entry the mount rule refuses (/, the home directory
# or above it, which a native install grants when it is run from the home
# directory) is skipped, so a narrower entry or DIR itself is used instead.
project_root() {
    roots | {
        best=''
        written=''
        while IFS= read -r entry; do
            while [ "${#entry}" -gt 1 ] && [ "${entry%/}" != "$entry" ]; do entry=${entry%/}; done
            case $entry in /*) ;; *) continue ;; esac
            [ -d "$entry" ] || continue
            candidate=$(physical "$entry")
            [ -n "$candidate" ] || continue
            if too_wide "$candidate" >/dev/null; then continue; fi
            if inside "$1" "$candidate" && [ "${#candidate}" -gt "${#best}" ]; then
                best=$candidate
                written=$entry
            fi
        done
        printf '%s\n%s\n' "${best:-$1}" "$written"
    }
}

# stop [--all]: the containers of this installation for one project root, or
# all of them.
stop_containers() {
    if [ "$1" = --all ]; then
        ids=$("$RUNTIME" ps -q --filter "label=io.knossos.install=$INSTALL_HASH" 2>/dev/null) \
            || die "$RUNTIME does not answer; is its daemon running?"
        what='for this installation'
    else
        ids=$("$RUNTIME" ps -q --filter "label=io.knossos.install=$INSTALL_HASH" --filter "label=io.knossos.root=$(hash12 "$1")" 2>/dev/null) \
            || die "$RUNTIME does not answer; is its daemon running?"
        what="for $1"
    fi
    if [ -z "$ids" ]; then
        printf 'No Knossos container is running %s.\n' "$what"
        return 0
    fi
    count=0
    for id in $ids; do
        "$RUNTIME" stop "$id" >/dev/null 2>&1 || die "could not stop container $id"
        count=$((count + 1))
    done
    printf 'Stopped %s Knossos container(s) %s.\n' "$count" "$what"
}

# A run of the image that the runtime must not pull: when the image is gone,
# say so instead.
image_gone() {
    "$RUNTIME" image inspect "$IMAGE" >/dev/null 2>&1 </dev/null && return 1
    "$RUNTIME" info >/dev/null 2>&1 </dev/null || die "the $RUNTIME daemon is not running; start it and try again."
    die "the image $IMAGE is gone from this host: run knossos self-update to fetch it again, or re-run the installer."
}

# The first line of project_root's answer.
root_of() { project_root "$1" | head -n 1; }

HERE=$(pwd -P 2>/dev/null) || die 'the working directory cannot be read'

# Answered on the host, before any project root is worked out: neither mounts
# anything, so both work from anywhere, / included (a timer runs from there).
case ${1-} in
    stop)
        case ${2-} in
            --all) stop_containers --all ;;
            '') stop_containers "$(root_of "$HERE")" ;;
            *)
                given=$(physical "$2")
                if [ -z "$given" ] || [ $# -ne 2 ]; then die 'usage: knossos stop [--all | <project directory>]'; fi
                stop_containers "$(root_of "$given")"
                ;;
        esac
        exit
        ;;
    self-update)
        # The background check the session-start hook runs: nothing at all
        # when it is turned off or the last look is less than a day old, so a
        # session start costs no container run for it. A stamp from the
        # future (a clock that went back) is due, as in UpdateCheck::due.
        shift
        quiet=0
        case " $* " in *' --check '*) case " $* " in *' --quiet '*) quiet=1 ;; esac ;; esac
        if [ "$quiet" = 1 ]; then
            [ "${KNOSSOS_NO_UPDATE_CHECK:-}" != 1 ] || exit 0
            cache="$INSTALL_DIR/update-check.json"
            if [ -f "$cache" ] && [ -z "$(find "$cache" -mmin +1439 2>/dev/null)" ]; then
                now=$(mktemp "${TMPDIR:-/tmp}/knossos-now.XXXXXX") || exit 0
                future=$(find "$cache" -newer "$now" 2>/dev/null)
                rm -f "$now"
                [ -n "$future" ] || exit 0
            fi
        fi
        # The update runs on the host, from the helper of the image last
        # switched to: the code in a container cannot replace its own image.
        # Every switch leaves a copy beside install.json, so an update still
        # works when the image itself is gone from the host. An installation
        # without that copy reads it out of the image. The helper is exec'd, so
        # a signal (the hook's timeout) reaches it; a temporary copy deletes
        # itself, named in KNOSSOS_UPDATE_HELPER.
        if [ -s "$INSTALL_DIR/container-update" ]; then
            exec sh "$INSTALL_DIR/container-update" self-update "--install-dir=$INSTALL_DIR" "$@"
        fi
        helper=$(mktemp "${TMPDIR:-/tmp}/knossos-update.XXXXXX") || die 'could not create a temporary file'
        if ! "$RUNTIME" run --rm --pull=never --network none --entrypoint cat "$IMAGE" "$IN_IMAGE/tools/launcher/container-update" > "$helper" 2>/dev/null </dev/null \
            || [ ! -s "$helper" ]; then
            rm -f "$helper"
            [ "$quiet" = 0 ] || exit 0
            "$RUNTIME" info >/dev/null 2>&1 </dev/null || die "the $RUNTIME daemon is not running; start it and try again."
            die "could not read the update helper out of $IMAGE, and $INSTALL_DIR has no copy of it; re-run the installer."
        fi
        KNOSSOS_UPDATE_HELPER=$helper
        export KNOSSOS_UPDATE_HELPER
        exec sh "$helper" self-update "--install-dir=$INSTALL_DIR" "$@"
        ;;
esac

# From here on a container is started or used, so the mount rule must be able
# to tell where the home directory is.
[ -n "$HOME_REAL" ] || die 'container mode needs HOME to point at your home directory, to keep it out of every container; set HOME and try again.'

# Every path the container is given, physical, decided once: the mounts, the
# environment passed in, the working directory, the container's name and the
# marker all use these, so each names inside exactly what is mounted. The core
# keys projects by their real path too (RootGuard::resolve), as native mode does.
#
# A directory that does not exist yet is created first, and never through a
# `..` component, so the directory checked is the one created.
make_dir() {
    case $1 in /*) ;; *) die "$2 must be an absolute path in container mode, got $1" ;; esac
    if [ ! -d "$1" ]; then
        case /$1/ in */../* | */./*) die "$2 names a directory to create through '..' or '.' ($1); spell it without them." ;; esac
        mkdir -p -- "$1" 2>/dev/null || die "could not create $1"
    fi
    made=$(physical "$1")
    [ -n "$made" ] || die "could not enter $1"
}
make_dir "$KNOSSOS_DATA_DIR" KNOSSOS_DATA_DIR
DATA_REAL=$made
INSTALL_PARENT=$(dirname -- "$INSTALL_REAL")
ROOTS_DIR_REAL=$INSTALL_REAL
ROOTS_FILE_REAL="$INSTALL_REAL/roots.json"
if [ -n "$ROOTS_GIVEN" ]; then
    make_dir "$(dirname -- "$ROOTS_GIVEN")" KNOSSOS_ROOTS_FILE
    ROOTS_DIR_REAL=$made
    ROOTS_FILE_REAL="${ROOTS_DIR_REAL%/}/${ROOTS_GIVEN##*/}"
    if [ "$ROOTS_FILE_REAL" = "$INSTALL_PARENT/roots.json" ] || [ "$ROOTS_FILE_REAL" = "$DATA_REAL/roots.json" ]; then
        ROOTS_DIR_REAL=$INSTALL_REAL
        ROOTS_FILE_REAL="$INSTALL_REAL/roots.json"
    elif inside "$ROOTS_DIR_REAL" "$INSTALL_REAL"; then
        # In the install directory: the host's own, read-only to every container.
        :
    elif inside "$ROOTS_FILE_REAL" "$DATA_REAL"; then
        die "KNOSSOS_ROOTS_FILE ($ROOTS_FILE_REAL) lies in the graph directory $DATA_REAL, which a container can write; unset it to use the list the installer keeps in $INSTALL_REAL/roots.json, or point it at a file outside every directory a container can write."
    fi
fi
KNOSSOS_ROOTS_FILE=$ROOTS_FILE_REAL

# Where the call works from, and the directory that decides the project root:
# the working directory, or the path argument of a command that takes a
# project path first (scan <path>, allow-root <path>, session-brief <path>,
# every query and every command the plugin's hooks run). That argument is
# handed on as its absolute physical path, so it still means the same
# directory when the call has to work from somewhere else. Any other command
# keeps its arguments exactly as given, even one that happens to name a
# directory.
TARGET=$HERE
takes_path=no
case ${1-} in
    scan | rescan | allow-root | claim | autostart | session-brief | brief | watch | record-scan-failure | move-project | \
        turn-brief | dashboard | component-detail | file-detail | file-context | graph-search | branch-diff | churn | \
        blast-radius | path-between | annotate | notes | note-adopt | note-move | note-check | note-confirm | \
        notes-export | notes-import | session-changes | session-head | session-diff | boundary-couplings | \
        list-snapshots | snapshot-diff | quality-gate | architecture-trends | find-component | inspect-component | \
        list-usages | architecture-summary | file-metrics | untested-code | explain-flow | impact-analysis | \
        dependency-cycles | architecture-health | check-architecture | suggest-location | change-impact | \
        changed-files-impact | test-impact | review-diff | architecture-context | export-diagram | \
        export-agent-brief | list-boundaries | search-architecture | annotate-component | list-annotations | \
        creation-brief) takes_path=yes ;;
esac
if [ "$takes_path" = yes ] && [ $# -ge 2 ]; then
    case $2 in
        -*) ;;
        *)
            if [ -d "$2" ] && given=$(physical "$2") && [ -n "$given" ]; then
                TARGET=$given
                command=$1
                shift 2
                set -- "$command" "$TARGET" "$@"
            fi
            ;;
    esac
fi
answer=$(project_root "$TARGET")
ROOT=${answer%%"$NEWLINE"*}
LISTED_AS=${answer#*"$NEWLINE"}
if inside "$HERE" "$ROOT"; then WORKDIR=$HERE; else WORKDIR=$ROOT; fi

# A roots file inside the project is the scanned project's to write, never the host's list.
if ! inside "$ROOTS_DIR_REAL" "$INSTALL_REAL" && inside "$ROOTS_FILE_REAL" "$ROOT"; then
    die "KNOSSOS_ROOTS_FILE ($ROOTS_FILE_REAL) lies inside the project root $ROOT, whose files the scanned project controls; unset it to use the list the installer keeps in $INSTALL_REAL/roots.json."
fi

# guard_writable PATH KIND: refuse a read-write mount that contains or is a
# directory the host trusts (see the threat note at the top). The graph
# directory may be the directory around the install directory, which then is
# a direct child of that mount's root and cannot be moved aside from inside,
# but it may not hold it any deeper. The roots file's directory may be the
# graph directory itself: that is the same mount.
guard_writable() {
    if [ "$2" = data ]; then
        if [ "$1" != "$INSTALL_PARENT" ] && inside "$INSTALL_REAL" "$1"; then
            die "KNOSSOS_DATA_DIR ($1) contains the install directory $INSTALL_REAL deeper than one level, where a container could move it aside; point KNOSSOS_DATA_DIR at $INSTALL_PARENT or at a directory outside it."
        fi
    elif [ "$2" != roots ] || [ "$1" != "$DATA_REAL" ]; then
        held=''
        if inside "$INSTALL_REAL" "$1"; then
            held="the install directory $INSTALL_REAL"
        elif inside "$DATA_REAL" "$1"; then
            held="the Knossos data directory $DATA_REAL"
        fi
        if [ -n "$held" ]; then
            case $2 in
                project) die "the project root $1 contains $held, which a container must never be able to write; run knossos from a project that does not contain it, or re-run the installer with --data-dir outside the project." ;;
                *) die "the directory of KNOSSOS_ROOTS_FILE ($1) contains $held, which a container must never be able to write; move the roots file to a directory of its own and point KNOSSOS_ROOTS_FILE at it." ;;
            esac
        fi
    fi
    while IFS= read -r held; do
        [ -n "$held" ] || continue
        inside "$held" "$1" || continue
        case $2 in
            project) die "the project root $1 contains $held, the directory of the knossos launcher, which a container must never be able to write; run knossos from a project that does not contain it, or re-run the installer with --bin-dir outside the project." ;;
            data) die "KNOSSOS_DATA_DIR ($1) contains $held, the directory of the knossos launcher, which a container must never be able to write; re-run the installer with --bin-dir outside the data directory." ;;
            *) die "the directory of KNOSSOS_ROOTS_FILE ($1) contains $held, the directory of the knossos launcher, which a container must never be able to write; move the roots file to a directory of its own and point KNOSSOS_ROOTS_FILE at it." ;;
        esac
    done <<HELD
$LAUNCHER_DIRS
HELD
}

# ---- the allow-list, kept by the host -----------------------------------------
#
# allow-root and claim are carried out here, on the host, and never in a
# container: the list lives where no container can write. The edit is small
# enough to make safely in shell: the launcher reads the entries as it reads
# them to choose a project root (roots above), appends one, and writes the
# whole list again, pretty-printed as JSON with only `\` and `"` escaped, into
# a new file renamed over the old one, under a lock directory beside it. A
# list holding an entry this reader cannot reproduce byte for byte (a \u or
# control escape) is not rewritten. Their answers are the ones the commands
# give in native mode, so the plugin's hooks read them the same way.

# root_problem DIR: why DIR may not become a project root, or nothing.
root_problem() {
    (
        if reason=$(too_wide "$1"); then die "the project root $1 $reason, which container mode does not mount; run knossos from inside a project."; fi
        if inside "$1" "$INSTALL_REAL"; then die "$1 lies inside the install directory $INSTALL_REAL, which a container may only read; point KNOSSOS_DATA_DIR, KNOSSOS_ROOTS_FILE or the project elsewhere."; fi
        guard_writable "$1" project
    ) 2>&1 >/dev/null | sed 's/^knossos: //'
}

# normal ROOT: a root as the server compares it, trailing slashes gone.
normal() {
    entry=$1
    while [ "${#entry}" -gt 1 ] && [ "${entry%/}" != "$entry" ]; do entry=${entry%/}; done
    printf '%s' "$entry"
}

# listed ROOT: whether the list names ROOT, compared as the server compares.
listed() {
    while IFS= read -r entry; do
        [ "$(normal "$entry")" != "$1" ] || return 0
    done <<ENTRIES
$(roots)
ENTRIES
    return 1
}

ROOTS_LOCK=''
# shellcheck disable=SC2317,SC2329 # run from the EXIT trap
unlock_roots() { [ -z "$ROOTS_LOCK" ] || rmdir -- "$ROOTS_LOCK" 2>/dev/null; }
lock_roots() {
    ROOTS_LOCK="$ROOTS_FILE_REAL.lock.d"
    tries=0
    until mkdir -- "$ROOTS_LOCK" 2>/dev/null; do
        tries=$((tries + 1))
        if [ "$tries" -ge 10 ]; then
            ROOTS_LOCK=''
            printf '%s' "Unable to lock $ROOTS_FILE_REAL: $ROOTS_FILE_REAL.lock.d has been held for 10 seconds; remove it if no knossos call is running."
            return 1
        fi
        sleep 1
    done
    trap unlock_roots EXIT
}

# write_roots ENTRY...: the list, replaced whole. Prints why when it cannot.
write_roots() {
    if [ -f "$ROOTS_FILE_REAL" ] && grep -q '\\[ubfnrt]' "$ROOTS_FILE_REAL"; then
        printf '%s' "$ROOTS_FILE_REAL holds an entry with an escape this launcher cannot rewrite safely; edit it by hand."
        return 1
    fi
    if ! next=$(mktemp "$ROOTS_DIR_REAL/.roots.XXXXXX" 2>/dev/null); then
        printf '%s' "Unable to write $ROOTS_FILE_REAL."
        return 1
    fi
    {
        printf '{\n    "roots": ['
        separator=''
        for entry in "$@"; do
            printf '%s\n        %s' "$separator" "$(json_string "$entry")"
            separator=','
        done
        if [ $# -gt 0 ]; then printf '\n    ]\n}\n'; else printf ']\n}\n'; fi
    } > "$next" && chmod 0600 "$next" && mv -f -- "$next" "$ROOTS_FILE_REAL" && return 0
    rm -f -- "$next"
    printf '%s' "Unable to write $ROOTS_FILE_REAL."
    return 1
}

# json_string TEXT: TEXT as a JSON string.
json_string() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# add_root ROOT: append ROOT to the list under the lock. Prints why when it cannot.
add_root() {
    lock_roots || return 1
    set -- "$1"
    while IFS= read -r entry; do
        [ -n "$entry" ] && set -- "$@" "$entry"
    done <<ENTRIES
$(roots)
ENTRIES
    added=$1
    shift
    write_roots "$@" "$added"
    result=$?
    unlock_roots
    ROOTS_LOCK=''
    return "$result"
}

# The options allow-root and claim take, as their native commands take them.
roots_options() {
    execute=no
    json=no
    folder=''
    for argument in "$@"; do
        case $argument in
            --execute | --execute=true | --execute=1 | --execute=yes | --execute=on) execute=yes ;;
            --execute=*) execute=no ;;
            --json | --json=true | --json=1 | --json=yes | --json=on) json=yes ;;
            --json=*) json=no ;;
            --db=*)
                case $(located "${argument#--db=}") in
                    "$DATA_REAL"/*) ;;
                    *) die "--db names ${argument#--db=}, outside the graph directory $DATA_REAL; in container mode the database lives there, so point KNOSSOS_DATA_DIR at its directory instead." ;;
                esac
                ;;
            --*) printf 'KNOSSOS_INVALID_ARGUMENT: Unknown option: %s\n' "${argument%%=*}" >&2; exit 2 ;;
            *) [ -n "$folder" ] || folder=$argument ;;
        esac
    done
}

# not_a_folder USAGE: the native answer for a missing or absent folder.
not_a_folder() {
    if [ -z "$folder" ]; then printf 'KNOSSOS_INVALID_ARGUMENT: %s\n' "$1" >&2; else printf 'KNOSSOS_INVALID_ARGUMENT: %s is not an existing directory.\n' "$folder" >&2; fi
    exit 2
}

EFFECT='A server configured with that roots file re-reads it per request, so %s with no restart.'
case ${1-} in
    allow-root)
        shift
        roots_options "$@"
        if [ -n "$folder" ]; then
            case $folder in /*) ;; *) printf 'KNOSSOS_INVALID_ARGUMENT: %s is not absolute. allow-root needs an absolute path so it can be compared against scan requests.\n' "$folder" >&2; exit 2 ;; esac
        fi
        if [ -z "$folder" ] || [ ! -d "$folder" ]; then not_a_folder 'Usage: knossos allow-root <path> [--execute] [--db=FILE] [--json]'; fi
        path=$(normal "$folder")
        problem=$(root_problem "$(physical "$path")")
        [ -z "$problem" ] || die "$problem"
        quoted_path=$(json_string "$path")
        quoted_file=$(json_string "$ROOTS_FILE_REAL")
        if listed "$path"; then
            if [ "$json" = yes ]; then printf '{"path":%s,"roots_file":%s,"added":false}\n' "$quoted_path" "$quoted_file"; else printf '%s is already present in %s. Nothing to do.\n' "$path" "$ROOTS_FILE_REAL"; fi
            exit 0
        fi
        if [ "$execute" = no ]; then
            if [ "$json" = yes ]; then
                printf '{"path":%s,"roots_file":%s,"roots_file_source":"named","added":false,"preview":true}\n' "$quoted_path" "$quoted_file"
            else
                # shellcheck disable=SC2059 # EFFECT is the native message's template
                printf "Would add %s to %s.\n$EFFECT\nRe-run with --execute to write it.\n" "$path" "$ROOTS_FILE_REAL" 'the addition would take effect'
            fi
            exit 0
        fi
        if ! problem=$(add_root "$path"); then printf 'KNOSSOS_INVALID_ARGUMENT: %s\n' "$problem" >&2; exit 2; fi
        if [ "$json" = yes ]; then
            printf '{"path":%s,"roots_file":%s,"roots_file_source":"named","added":true}\n' "$quoted_path" "$quoted_file"
        else
            # shellcheck disable=SC2059 # EFFECT is the native message's template
            printf "Added %s to %s.\n$EFFECT\n" "$path" "$ROOTS_FILE_REAL" 'this takes effect immediately'
        fi
        exit 0
        ;;
    claim)
        shift
        roots_options "$@"
        if [ -z "$folder" ] || [ ! -d "$folder" ]; then not_a_folder 'Usage: knossos claim <path> [--execute] [--db=FILE] [--json]'; fi
        # claim_answer STATUS ROOT [REASON]: one outcome; every one exits 0.
        claim_answer() {
            if [ "$json" = yes ]; then
                if [ -n "${3-}" ]; then reason=$(json_string "$3"); else reason=null; fi
                printf '{"status":"%s","root":%s,"reason":%s}\n' "$1" "$(json_string "$2")" "$reason"
            else
                printf '%s: %s%s\n' "$1" "$2" "${3:+ ($3)}"
            fi
            exit 0
        }
        # The folder, and the root a start there claims: the nearest folder
        # holding a .git, a directory or the file a linked worktree has, else
        # the folder itself (StartClaim::targetOf).
        started=$(physical "$folder")
        root=$started
        current=$started
        while :; do
            if [ -e "$current/.git" ]; then root=$current; break; fi
            [ "$current" != / ] || break
            current=$(dirname -- "$current")
        done
        if [ ! -r "$ROOTS_FILE_REAL" ] && [ -e "$ROOTS_FILE_REAL" ]; then claim_answer error "$root" "Unable to read $ROOTS_FILE_REAL."; fi
        if listed "$started"; then claim_answer present "$started"; fi
        if listed "$root"; then claim_answer present "$root"; fi
        if [ "$root" = / ] || inside "$HOME_REAL" "$root"; then
            claim_answer ask "$root" "$root is the filesystem root, your home folder or a folder above it, so it is not allowed without being asked."
        fi
        [ "$execute" = yes ] || claim_answer would-add "$root"
        problem=$(root_problem "$root")
        [ -z "$problem" ] || claim_answer error "$root" "$problem"
        problem=$(add_root "$root") || claim_answer error "$root" "$problem"
        claim_answer added "$root"
        ;;
esac

# move-project --execute swaps the old root for the new one in the list. Here
# that is done by the host before the command runs, so the command finds the
# list already as it wants it and writes nothing; should the command fail, the
# list is put back as it was.
ROOTS_BEFORE=''
if [ "${1-}" = move-project ]; then
    execute=no
    moves=''
    for argument in "$@"; do
        case $argument in
            move-project) ;;
            --execute | --execute=true | --execute=1 | --execute=yes | --execute=on) execute=yes ;;
            --*) ;;
            *) moves="$moves$argument$NEWLINE" ;;
        esac
    done
    if [ "$execute" = yes ]; then
        from=$(printf '%s' "$moves" | sed -n 1p)
        to=$(printf '%s' "$moves" | sed -n 2p)
        case $from in /*) ;; *) die 'in container mode move-project names the old root by its path, so the allow-list on the host can follow it.' ;; esac
        [ -d "$to" ] || die "the new root $to is not an existing directory."
        to=$(normal "$(physical "$to")")
        problem=$(root_problem "$to")
        [ -z "$problem" ] || die "$problem"
        if [ -d "$from" ]; then from=$(physical "$from"); fi
        from=$(normal "$from")
        # moved_list: the list without the old root and with the new one, written.
        moved_list() {
            set --
            while IFS= read -r entry; do
                [ -n "$entry" ] || continue
                [ "$(normal "$entry")" != "$from" ] || continue
                set -- "$@" "$entry"
            done <<ENTRIES
$(roots)
ENTRIES
            if ! listed "$to"; then set -- "$@" "$to"; fi
            write_roots "$@"
        }
        ROOTS_BEFORE=$(mktemp "${TMPDIR:-/tmp}/knossos-roots.XXXXXX") || die 'could not create a temporary file'
        ROOTS_HAD=no
        if [ -f "$ROOTS_FILE_REAL" ]; then ROOTS_HAD=yes; fi
        if ! problem=$(
            lock_roots || exit 1
            if [ "$ROOTS_HAD" = yes ] && ! cp -- "$ROOTS_FILE_REAL" "$ROOTS_BEFORE"; then
                printf '%s' "Unable to read $ROOTS_FILE_REAL."
                unlock_roots
                exit 1
            fi
            moved_list
            written=$?
            unlock_roots
            exit "$written"
        ); then
            rm -f -- "$ROOTS_BEFORE"
            die "$problem"
        fi
    fi
fi

# restore_roots: the list as it was before move-project, after a failed move.
restore_roots() {
    [ -n "$ROOTS_BEFORE" ] || return 0
    if [ "$ROOTS_HAD" = yes ]; then mv -f -- "$ROOTS_BEFORE" "$ROOTS_FILE_REAL"; else rm -f -- "$ROOTS_FILE_REAL" "$ROOTS_BEFORE"; fi
    ROOTS_BEFORE=''
}

# Every directory the container is given, each mounted at its own physical
# path with its mode (`true` read-write, `false` read-only), and only through
# add_mount: it applies the mount rule to exactly the path it mounts (no /, no
# home directory, nothing above it, nothing inside the read-only install
# directory, and nothing the host trusts, see guard_writable). A directory
# that lies inside another mount of the same mode is already visible through
# it and is not mounted twice; one of another mode is mounted on top, which the
# runtime orders by depth. So the project, always read-only, is its own mount
# even inside the graph directory, and the graph directory is always its own
# read-write mount: guard_writable leaves nothing that could contain it. The
# install directory is the read-only mount added last.
MOUNTS=''
# add_mount DIR KIND READ-WRITE
add_mount() {
    path=$(physical "$1")
    [ -n "$path" ] || die "could not enter $1 to mount it"
    case $path in
        *,* | *'|'* | *"$NEWLINE"*) die "a path with a comma, a bar or a newline cannot be mounted: $path" ;;
    esac
    if reason=$(too_wide "$path"); then
        case $2 in
            project) die "the project root $path $reason, which container mode does not mount; run knossos from inside a project." ;;
            data) die "KNOSSOS_DATA_DIR ($KNOSSOS_DATA_DIR) $reason, which container mode does not mount; point KNOSSOS_DATA_DIR at a directory of its own." ;;
            roots) die "the directory of KNOSSOS_ROOTS_FILE ($path) $reason, which container mode does not mount; put the roots file in a directory of its own and point KNOSSOS_ROOTS_FILE at it." ;;
            *) die "the install directory $path $reason, which container mode does not mount; re-run the installer with --data-dir set to a directory of its own." ;;
        esac
    fi
    if inside "$path" "$INSTALL_REAL"; then
        die "$path lies inside the install directory $INSTALL_REAL, which a container may only read; point KNOSSOS_DATA_DIR, KNOSSOS_ROOTS_FILE or the project elsewhere."
    fi
    guard_writable "$path" "$2"
    kept=''
    while IFS='|' read -r mounted rw; do
        [ -n "$mounted" ] || continue
        if [ "$rw" = "$3" ] && inside "$path" "$mounted"; then
            # Unreachable for the graph directory after guard_writable; never
            # let it ride on another mount all the same.
            [ "$2" != data ] || die "the graph directory $path lies inside the mount $mounted; point KNOSSOS_DATA_DIR at a directory of its own."
            return 0
        fi
        if [ "$rw" = "$3" ] && inside "$mounted" "$path"; then continue; fi
        kept="$kept$mounted|$rw$NEWLINE"
    done <<MOUNTED
$MOUNTS
MOUNTED
    MOUNTS="$kept$path|$3$NEWLINE"
}
add_mount "$ROOT" project false
add_mount "$DATA_REAL" data true
# The roots file's directory read-only, unless it is the install directory.
if ! inside "$ROOTS_DIR_REAL" "$INSTALL_REAL"; then add_mount "$ROOTS_DIR_REAL" roots false; fi
# The install directory read-only, on top: always its own mount, even when a
# read-write one contains it.
if too_wide "$INSTALL_REAL" >/dev/null; then die "the install directory $INSTALL_REAL $(too_wide "$INSTALL_REAL"), which container mode does not mount; re-run the installer with --data-dir set to a directory of its own."; fi
MOUNTS="$MOUNTS$INSTALL_REAL|false$NEWLINE"
# Each mount as `docker inspect` reports it: source|destination|read-write.
EXPECTED=$(
    while IFS='|' read -r mounted rw; do
        [ -n "$mounted" ] && printf '%s|%s|%s\n' "$mounted" "$mounted" "$rw"
    done <<MOUNTED
$MOUNTS
MOUNTED
)
EXPECTED=$(printf '%s\n' "$EXPECTED" | LC_ALL=C sort)

# ---- files a command names ------------------------------------------------
#
# The project is read-only in the container, so a file a command is told to
# write goes through the host, and a file it is told to read that lies outside
# every mount is copied in. FILE_ROLES says what each option (`--name`) or
# positional argument (`@N`, `@N...` for that one and every one after it) that
# names a file means here, one `command key role` per line:
#   output    written by the command into a fresh scratch file, which the host
#             moves to the path named once the command has succeeded
#   input     read by the command: passed on as is inside a mount, else
#             copied into the scratch directory first, read-only
#   project   a file of the project, read through its read-only mount
#   database  the graph database, which has to lie in the graph directory
#   none      not a file on this host (a name, a prefix, a root to grant)
#   refused   a command container mode leaves to the host's installer
# `*` as the command means every command. tests/phpunit/Cli/LauncherFileRolesTest
# reads this table and the CLI reference's usage block, and fails when an
# option or argument that takes a file has no line here, or a line here names
# nothing the CLI takes.
FILE_ROLES='
* --db database
export-bundle --output output
export-agent-brief --out output
export-notes --file output
notes-export --file output
import-bundle @1 input
import-notes --file input
notes-import --file input
quality-gate --budgets input
quality-gate --policies input
check-architecture --policies input
review-diff --budgets input
review-diff --policies input
turn-brief --policies input
architecture-context @2... project
changed-files-impact @2... project
test-impact @2... project
review-diff @2... project
creation-brief @2 project
file-context @1 project
file-detail @1 project
annotate-component --evidence project
session-diff --file project
turn-brief --files project
architecture-health --path-prefix none
maintain-database --backup-name none
serve --allow-root none
install-agent-plugin --bin refused
install-agent-plugin --data refused
install-agent-plugin --data-dir refused
install-agent-plugin --out refused
install-agent-plugin --plugin-dir refused
'

# file_role COMMAND KEY [POSITION]: sets `role` for an option (`--name`) or a
# positional argument (KEY `@`, POSITION its number), or to nothing.
file_role() {
    role=''
    while read -r row_command row_key row_role; do
        [ -n "$row_command" ] || continue
        [ "$row_command" = '*' ] || [ "$row_command" = "$1" ] || continue
        case $row_key in
            @*...)
                first=${row_key#@}
                first=${first%...}
                if [ "$2" != @ ] || [ "${3:-0}" -lt "$first" ]; then continue; fi
                ;;
            @*) if [ "$2" != @ ] || [ "@${3:-0}" != "$row_key" ]; then continue; fi ;;
            *) [ "$2" = "$row_key" ] || continue ;;
        esac
        role=$row_role
        return 0
    done <<ROLES
$FILE_ROLES
ROLES
}

# absolute PATH: PATH made absolute against the working directory on the host.
absolute() { case $1 in /*) printf '%s' "$1" ;; *) printf '%s/%s' "${HERE%/}" "$1" ;; esac; }

# located PATH: the physical form of a file's directory with its name, or the
# absolute path as given when that directory does not exist.
located() {
    file=$(absolute "$1")
    dir=$(physical "$(dirname -- "$file")")
    if [ -n "$dir" ]; then printf '%s/%s' "${dir%/}" "${file##*/}"; else printf '%s' "$file"; fi
}

# mounted PATH: whether a physical path lies in a directory the container sees.
mounted() {
    while IFS='|' read -r mount rw; do
        [ -n "$mount" ] || continue
        if inside "$1" "$mount"; then return 0; fi
    done <<MOUNTED
$MOUNTS
MOUNTED
    return 1
}

# The scratch directory: made by the host, private to you, in the graph
# directory (read-write in the container) and removed when the call ends. A
# container can write it too, so the host never opens anything in it by path:
# it moves files in and out by rename from inside the directory itself, after
# checking that it still is the directory it made, and checks what it moved
# out in a private directory of its own before it writes the destination.
SCRATCH=''
SCRATCH_ID=''
PRIVATE=''
OUTPUT_SCRATCH=''
OUTPUT_DEST=''
OUTPUT_EXISTED=no
# shellcheck disable=SC2317,SC2329 # run from the EXIT trap
cleanup_files() {
    [ -z "$PRIVATE" ] || rm -rf -- "$PRIVATE"
    [ -z "$SCRATCH" ] || rm -rf -- "$SCRATCH"
}
scratch() {
    [ -z "$SCRATCH" ] || return 0
    trap cleanup_files EXIT
    PRIVATE=$( (umask 077 && mktemp -d "${TMPDIR:-/tmp}/knossos-files.XXXXXX") ) || die 'could not create a private temporary directory'
    SCRATCH=$( (umask 077 && mktemp -d "$DATA_REAL/.knossos-files.XXXXXX") ) || die "could not create a scratch directory in $DATA_REAL"
    SCRATCH_ID=$(dir_id "$SCRATCH") || die "could not read the scratch directory $SCRATCH"
}
# in_scratch COMMAND...: run a command from inside the scratch directory, once
# it is known to be the one this call made.
in_scratch() {
    (CDPATH='' cd -P -- "$SCRATCH" 2>/dev/null && [ "$(dir_id .)" = "$SCRATCH_ID" ] && "$@")
}

# The host refuses a destination it cannot place, before anything runs: its
# directory must exist, and the name must not be a link or a directory.
place_output() {
    dest=$(located "$1")
    parent=$(dirname -- "$dest")
    [ -d "$parent" ] || die "cannot write $dest: the directory $parent does not exist."
    [ ! -L "$dest" ] || die "$dest is a symlink; name the file itself, not a link to it."
    [ ! -d "$dest" ] || die "$dest is a directory; name a file to write."
    if inside "$dest" "$DATA_REAL" || inside "$dest" "$INSTALL_REAL"; then
        die "$dest lies in the Knossos data directory, which a container can write; write it somewhere else."
    fi
    [ -z "$OUTPUT_DEST" ] || die "a call can name one file to write in container mode."
    scratch
    OUTPUT_DEST=$dest
    OUTPUT_SCRATCH="$SCRATCH/output"
    if [ -e "$dest" ]; then OUTPUT_EXISTED=yes; fi
    # What the command would refuse to replace, decided here: the container
    # writes a fresh file and cannot see the one in place.
    case $COMMAND in
        export-bundle)
            if [ "$OUTPUT_EXISTED" = yes ]; then
                printf 'KNOSSOS_INVALID_ARGUMENT: Bundle output already exists: %s\n' "$dest" >&2
                exit 2
            fi
            ;;
        export-notes | notes-export)
            if [ "$OUTPUT_EXISTED" = yes ] && ! notes_file "$dest"; then
                reason="NOTES_FILE_NOT_NOTES: $dest exists and is not a knossos notes file; remove it or pick another --file."
                if [ "$COMMAND" = notes-export ]; then
                    if [ "$JSON" = yes ]; then printf '{"status":"refused","reason":%s}\n' "$(json_text "$reason")"; else printf 'refused: %s\n' "$reason"; fi
                    exit 0
                fi
                printf 'KNOSSOS_INVALID_ARGUMENT: %s\n' "$reason" >&2
                exit 2
            fi
            ;;
    esac
}

# notes_file FILE: whether a file in the way is a previous notes file, as
# NotesFile::looksLikeNotesFile decides: JSON whose "format" is knossos-notes.
notes_file() {
    [ -f "$1" ] || return 1
    [ -z "$(find "$1" -size +10240k 2>/dev/null)" ] || return 1
    tr -d ' \t\r\n' < "$1" 2>/dev/null | grep -q '"format":"knossos-notes"'
}

# json_text TEXT: TEXT as a JSON string.
json_text() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# take_input PATH: what the command is given for a file it reads.
take_input() {
    file=$(located "$1")
    if mounted "$file" || [ ! -f "$file" ]; then
        given=$file
        return 0
    fi
    scratch
    INPUTS=$((INPUTS + 1))
    if ! cp -- "$file" "$PRIVATE/input-$INPUTS" 2>/dev/null || ! chmod 0444 "$PRIVATE/input-$INPUTS"; then
        die "could not read $file"
    fi
    in_scratch mv -f -- "$PRIVATE/input-$INPUTS" "./input-$INPUTS" || die "could not copy $file into $SCRATCH"
    given="$SCRATCH/input-$INPUTS"
}

# take_database PATH: --db, which must lie in the graph directory.
take_database() {
    given=$(located "$1")
    inside "$given" "$DATA_REAL" \
        || die "--db names $given, outside the graph directory $DATA_REAL; in container mode the database lives there, so point KNOSSOS_DATA_DIR at its directory instead."
}

# The command's arguments, with every file it names placed as FILE_ROLES says.
COMMAND=${1-}
JSON=no
INPUTS=0
for argument in "$@"; do case $argument in --json | --json=true | --json=1) JSON=yes ;; esac; done
if [ "$COMMAND" = install-agent-plugin ]; then
    die 'This is a container install: its plugin is managed from the host. Run knossos self-update there, or re-run the installer.'
fi
if [ $# -gt 0 ]; then
    # Each argument is taken off the front and its placed form put on the end,
    # so after one pass the list holds the placed arguments only.
    shift
    count=$#
    position=0
    pending=''
    ended=no
    file_named=no
    while [ "$count" -gt 0 ]; do
        argument=$1
        shift
        count=$((count - 1))
        if [ "$ended" = yes ]; then set -- "$@" "$argument"; continue; fi
        if [ -n "$pending" ]; then
            key=$pending
            value=$argument
            pending=''
            file_role "$COMMAND" "$key"
        else
            case $argument in
                --)
                    ended=yes
                    set -- "$@" "$argument"
                    continue
                    ;;
                --*=*)
                    key=${argument%%=*}
                    value=${argument#*=}
                    file_role "$COMMAND" "$key"
                    ;;
                --*)
                    # `--name PATH`, which the CLI itself does not read, is
                    # taken as `--name=PATH` for an option that names a file.
                    file_role "$COMMAND" "$argument"
                    if [ -n "$role" ] && [ "$role" != none ] && [ "$count" -gt 0 ]; then pending=$argument; fi
                    [ -n "$pending" ] || set -- "$@" "$argument"
                    continue
                    ;;
                *)
                    position=$((position + 1))
                    key=@
                    value=$argument
                    file_role "$COMMAND" @ "$position"
                    ;;
            esac
        fi
        given=$value
        case $role in
            output)
                place_output "$value"
                given=$OUTPUT_SCRATCH
                if [ "$key" = --file ]; then file_named=yes; fi
                ;;
            input) take_input "$value" ;;
            database) take_database "$value" ;;
            refused) die "$key is not available in container mode." ;;
        esac
        if [ "$key" = @ ]; then set -- "$@" "$given"; else set -- "$@" "$key=$given"; fi
    done
    set -- "$COMMAND" "$@"
    # export-notes and notes-export write knossos-notes.json in the project
    # when no --file is named; the host writes it there, as any other output.
    case $COMMAND in
        export-notes | notes-export)
            if [ "$file_named" = no ]; then
                folder=$HERE
                if [ "$COMMAND" = notes-export ]; then folder=$ROOT; fi
                for argument in "$@"; do
                    [ "$argument" != "$COMMAND" ] || continue
                    case $argument in -*) ;; *) if [ "$COMMAND" = export-notes ] && [ -d "$(absolute "$argument")" ]; then folder=$(physical "$(absolute "$argument")"); fi; break ;; esac
                done
                place_output "${folder%/}/knossos-notes.json"
                set -- "$@" "--file=$OUTPUT_SCRATCH"
            fi
            ;;
    esac
fi

NAME="knossos-$(hash12 "$INSTALL_REAL
$ROOT
$DATA_REAL
$ROOTS_FILE_REAL
$IMAGE")"
MARKER="$INSTALL_REAL/containers/$NAME"
# containers/ was checked above to be a real directory; the marker must be a
# plain file or absent, never a link this write could follow.
[ ! -L "$MARKER" ] || untrusted "$MARKER is a symlink"
: > "$MARKER" 2>/dev/null || die "could not write $MARKER"

# Start the container unless it runs. Two calls may get here at once: the
# runtime refuses the second `run` because the name is taken, and that call
# then finds the winner's container and uses it. A container that is still
# being created or removed is waited for; one that stopped is removed first.
start_container() {
    set -- run -d --rm --init --no-healthcheck --pull=never --name "$NAME" \
        --label "io.knossos.install=$INSTALL_HASH" --label "io.knossos.root=$(hash12 "$ROOT")" \
        --network none --user "$USER_SPEC"
    if [ "$RUNTIME" = podman ]; then set -- "$@" --userns=keep-id; fi
    set -- "$@" -e HOME=/tmp -e KNOSSOS_CONTAINER=0 \
        -e "KNOSSOS_CONTAINER_INSTALL_DIR=$INSTALL_REAL" \
        -e "KNOSSOS_DATA_DIR=$DATA_REAL" -e "KNOSSOS_ROOTS_FILE=$ROOTS_FILE_REAL" -e "KNOSSOS_SETTINGS_DIR=$DATA_REAL"
    while IFS='|' read -r mounted rw; do
        [ -n "$mounted" ] || continue
        if [ "$rw" = true ]; then
            set -- "$@" --mount "type=bind,source=$mounted,target=$mounted"
        else
            set -- "$@" --mount "type=bind,source=$mounted,target=$mounted,readonly"
        fi
    done <<MOUNTED
$MOUNTS
MOUNTED
    set -- "$@" --entrypoint "$IN_IMAGE/tools/launcher/idle-stop" "$IMAGE" "$MARKER"
    attempts=0
    while :; do
        found=$("$RUNTIME" container inspect --format "$INSPECT" "$NAME" 2>/dev/null) || found=absent
        state=${found%%"$NEWLINE"*}
        state=${state%%|*}
        case $state in
            running)
                check_mounts "$found"
                return 0
                ;;
            absent)
                if error=$("$RUNTIME" "$@" 2>&1 >/dev/null </dev/null); then
                    # Started: what the runtime mounted must be what was checked.
                    found=$("$RUNTIME" container inspect --format "$INSPECT" "$NAME" 2>/dev/null) || found=''
                    check_mounts "$found" new
                    return 0
                fi
                # Lost the race, or a real failure: only the second leaves no container behind.
                if ! "$RUNTIME" container inspect "$NAME" >/dev/null 2>&1; then
                    image_gone
                    die "could not start a container from $IMAGE: $error"
                fi
                ;;
            exited | dead) "$RUNTIME" rm -f "$NAME" >/dev/null 2>&1 ;;
        esac
        attempts=$((attempts + 1))
        [ "$attempts" -lt 30 ] || die "container $NAME did not start (last state: $state)"
        sleep 1
    done
}
# The state, the image, the network, the user and the mounts of a container in
# one inspect, so reusing a running container costs no extra call. The first
# line is `state|image|network|user`, then one `source|destination|rw` line per
# mount.
INSPECT='{{.State.Status}}|{{.Config.Image}}|{{.HostConfig.NetworkMode}}|{{.Config.User}}{{range .Mounts}}{{"\n"}}{{.Source}}|{{.Destination}}|{{.RW}}{{end}}'
USER_SPEC="$(id -u):$(id -g)"

# check_mounts INSPECT-OUTPUT [new]: refuse a container that does not run the
# image, the network and the user this launcher starts it with, or whose mounts
# are not exactly the ones checked, and remove it so it is never exec'd into.
# Podman reports a short image name in its fully qualified form, which counts
# as the same image. On a new one, each source must also still be its own
# physical path: the runtime resolves symlinks in a bind source when it
# mounts, so a component swapped for a link between the check and the run
# would have widened the mount.
check_mounts() {
    config=${1%%"$NEWLINE"*}
    config=${config#*|}
    same=no
    for image in "$IMAGE" "localhost/$IMAGE" "docker.io/$IMAGE" "docker.io/library/$IMAGE"; do
        if [ "$config" = "$image|none|$USER_SPEC" ]; then same=yes; fi
        [ "$RUNTIME" = podman ] || break
    done
    if [ "$same" = no ]; then
        "$RUNTIME" rm -f "$NAME" >/dev/null 2>&1 </dev/null
        die "container $NAME does not run the image, network or user that were checked, so it was removed; run the command again."
    fi
    got=$(printf '%s\n' "${1#*"$NEWLINE"}" | sed '/^$/d' | LC_ALL=C sort)
    case $1 in *"$NEWLINE"*) ;; *) got='' ;; esac
    if [ "$got" != "$EXPECTED" ]; then
        "$RUNTIME" rm -f "$NAME" >/dev/null 2>&1 </dev/null
        die "container $NAME does not have the mounts that were checked, so it was removed; run the command again."
    fi
    [ "${2-}" = new ] || return 0
    while IFS='|' read -r mounted rw; do
        [ -n "$mounted" ] || continue
        if [ "$(physical "$mounted")" != "$mounted" ]; then
            "$RUNTIME" rm -f "$NAME" >/dev/null 2>&1 </dev/null
            die "$mounted changed while container $NAME was started, so it was removed; run the command again."
        fi
    done <<MOUNTED
$MOUNTS
MOUNTED
}
start_container

# wants_terminal COMMAND: whether the call gets `-t`. Only when stdin and
# stdout are both terminals, as for an interactive `knossos tui`, and never
# for `serve`, whose JSON-RPC stream a TTY would corrupt.
# KNOSSOS_TEST_TERMINALS (`<stdin>,<stdout>`, each yes or no) stands in for
# the two terminal checks in tests, which have no terminal.
wants_terminal() {
    [ "${1-}" != serve ] || return 1
    if [ -n "${KNOSSOS_TEST_TERMINALS:-}" ]; then
        [ "$KNOSSOS_TEST_TERMINALS" = yes,yes ]
        return
    fi
    [ -t 0 ] && [ -t 1 ]
}

# The call itself. `-i` always, so the MCP server and anything piped in get
# their stdin; `-t` as wants_terminal decides. idle-stop --run records the
# command's process id inside the container, so a signal sent to this
# launcher is passed on to the command itself: the runtime's exec client does
# not forward one. The exit status is the command's.
#
# The list is built from its end: the command and its arguments stay as they
# are, and every option goes in front of them.
CALL_ID="$$-$(date +%s 2>/dev/null)"
terminal=no
if wants_terminal "${1-}"; then terminal=yes; fi
set -- "$NAME" "$IN_IMAGE/tools/launcher/idle-stop" --run "$CALL_ID" "$IN_IMAGE/bin/knossos" "$@"
# A root the roots file names through a symlink gets its physical form added
# to the allowed roots (see below), but not a root with a colon in it: the
# variable is a list split on `:`, so it would grant the pieces, two roots
# nobody listed.
extra_root=no
if [ -n "$LISTED_AS" ] && [ "$LISTED_AS" != "$ROOT" ]; then
    case $ROOT in *:*) ;; *) extra_root=yes ;; esac
fi
# A caller's other KNOSSOS_* settings reach the command too, by name, as they
# would in native mode.
for variable in $(env | sed -n 's/^\(KNOSSOS_[A-Za-z0-9_]*\)=.*/\1/p' | sort -u); do
    case $variable in
        KNOSSOS_DATA_DIR | KNOSSOS_ROOTS_FILE | KNOSSOS_SETTINGS_DIR | KNOSSOS_INSTALL_DIR | KNOSSOS_CONTAINER | KNOSSOS_CONTAINER_INSTALL_DIR | KNOSSOS_BIN | KNOSSOS_TEST_TERMINALS) ;;
        KNOSSOS_ALLOWED_ROOTS)
            if [ "$extra_root" = no ]; then set -- -e "$variable" "$@"; fi
            ;;
        *) set -- -e "$variable" "$@" ;;
    esac
done
# A root the roots file names through a symlink: inside, that spelling leads
# nowhere (only the physical target is mounted), so the server would not count
# it as allowed, although it reads the very same list. Its physical form is
# added to the allowed roots, which grants nothing the roots file did not.
if [ "$extra_root" = yes ]; then
    set -- -e "KNOSSOS_ALLOWED_ROOTS=${KNOSSOS_ALLOWED_ROOTS:+$KNOSSOS_ALLOWED_ROOTS:}$ROOT" "$@"
fi
if [ "$terminal" = yes ]; then
    set -- -t -e "TERM=${TERM:-xterm}" "$@"
fi
set -- exec -i -w "$WORKDIR" -e HOME=/tmp -e KNOSSOS_CONTAINER=0 \
    -e "KNOSSOS_CONTAINER_INSTALL_DIR=$INSTALL_REAL" \
    -e "KNOSSOS_DATA_DIR=$DATA_REAL" -e "KNOSSOS_ROOTS_FILE=$ROOTS_FILE_REAL" -e "KNOSSOS_SETTINGS_DIR=$DATA_REAL" "$@"

# shellcheck disable=SC2317,SC2329 # called from the traps below
forward() {
    "$RUNTIME" exec "$NAME" "$IN_IMAGE/tools/launcher/idle-stop" --signal "$1" "$CALL_ID" >/dev/null 2>&1 </dev/null
}
# finish_output: once the command has succeeded, the file it wrote goes to the
# path that was named, or nothing does. It is moved out of the scratch
# directory by rename from inside it (a link there is moved as a link, never
# followed), checked in the private directory to be a plain file, copied into
# a new file beside the destination and renamed over it, which replaces a name
# without following a link there.
finish_output() {
    # shellcheck disable=SC2016 # the inner sh expands its own argument
    if ! in_scratch sh -c 'if [ -e output ] || [ -L output ]; then mv -f -- output "$1/output"; fi' _ "$PRIVATE"; then
        printf 'knossos: the scratch directory %s changed while the command ran; nothing was written to %s.\n' "$SCRATCH" "$OUTPUT_DEST" >&2
        return 1
    fi
    if [ ! -e "$PRIVATE/output" ] && [ ! -L "$PRIVATE/output" ]; then return 0; fi
    if [ -L "$PRIVATE/output" ] || [ ! -f "$PRIVATE/output" ]; then
        printf 'knossos: the command left no plain file for %s; nothing was written.\n' "$OUTPUT_DEST" >&2
        return 1
    fi
    parent=$(dirname -- "$OUTPUT_DEST")
    if ! written=$(mktemp "$parent/.knossos-output.XXXXXX" 2>/dev/null); then
        printf 'knossos: could not write in %s; nothing was written to %s.\n' "$parent" "$OUTPUT_DEST" >&2
        return 1
    fi
    mode=$(printf '%o' $((0666 & ~0$(umask))))
    if ! cat < "$PRIVATE/output" > "$written" || ! chmod "$mode" "$written" \
        || [ -L "$OUTPUT_DEST" ] || [ -d "$OUTPUT_DEST" ] || ! mv -f -- "$written" "$OUTPUT_DEST"; then
        rm -f -- "$written"
        printf 'knossos: could not write %s; nothing was written.\n' "$OUTPUT_DEST" >&2
        return 1
    fi
}

# show_output: what the command printed, with the scratch path it was given
# shown as the path that was named.
show_output() {
    to=$OUTPUT_DEST
    if [ "$JSON" = yes ]; then to=$(json_text "$OUTPUT_DEST"); to=${to#\"}; to=${to%\"}; fi
    replaced=no
    case $COMMAND in export-notes | notes-export) replaced=$OUTPUT_EXISTED ;; esac
    FROM=$OUTPUT_SCRATCH TO=$to REPLACED=$replaced JSONOUT=$JSON awk '
        function swap(line, from, to,    out, i) {
            out = ""
            while ((i = index(line, from)) > 0) {
                out = out substr(line, 1, i - 1) to
                line = substr(line, i + length(from))
            }
            return out line
        }
        BEGIN { from = ENVIRON["FROM"]; to = ENVIRON["TO"] }
        {
            line = $0
            # The container saw no file in the way, so it said it replaced none.
            if (ENVIRON["REPLACED"] == "yes") {
                if (ENVIRON["JSONOUT"] == "yes") line = swap(line, "\"replaced\":false", "\"replaced\":true")
                else line = swap(line, from ".", to ". (replaced the previous file)")
            }
            print swap(line, from, to)
        }
    ' < "$PRIVATE/stdout"
}

# A background child of a non-interactive shell gets /dev/null as its stdin;
# the caller's stdin is handed over explicitly. A call that writes a file has
# its output kept until the file is in place.
exec 3<&0
if [ -n "$OUTPUT_DEST" ]; then
    "$RUNTIME" "$@" <&3 3<&- > "$PRIVATE/stdout" &
else
    "$RUNTIME" "$@" <&3 3<&- &
fi
CHILD=$!
exec 3<&-
trap 'forward TERM' TERM
trap 'forward INT' INT
trap 'forward HUP' HUP
# wait returns early when a trapped signal arrives; the child is waited for
# again until it has really ended, and its status is the one passed on.
while :; do
    wait "$CHILD"
    status=$?
    kill -0 "$CHILD" 2>/dev/null || break
done
if [ -n "$OUTPUT_DEST" ]; then
    if [ "$status" -eq 0 ] && ! finish_output; then status=1; fi
    show_output
fi
if [ "$status" -ne 0 ]; then restore_roots; elif [ -n "$ROOTS_BEFORE" ]; then rm -f -- "$ROOTS_BEFORE"; fi
exit "$status"
