#!/bin/sh
set -eu

image="${1:-knossos:quality-runtime}"
fixture="${KNOSSOS_LIFECYCLE_FIXTURE:-$PWD/tests/Fixtures/mixed}"
volume=$(docker volume create)
source_volume=$(docker volume create)
listings=$(mktemp -d)
trap 'docker volume rm "$volume" "$source_volume" >/dev/null; rm -rf "$listings"' EXIT

# The fixture is copied into a volume rather than bind-mounted from the host.
# When this script runs inside the quality container, the daemon resolves bind
# sources against the host filesystem, where this checkout's path does not
# necessarily exist. `docker cp` writes through the container's mounts, so the
# same command works from a workstation, a CI job container, and nested Docker.
seed=$(docker create --mount "type=volume,source=$source_volume,target=/workspace" "$image" true)
docker cp "$fixture/." "$seed:/workspace"
docker rm "$seed" >/dev/null

docker run --rm --mount "type=volume,source=$volume,target=/data" "$image" doctor --json >/dev/null
scan=$(docker run --rm --network none \
    --mount "type=volume,source=$volume,target=/data" \
    --mount "type=volume,source=$source_volume,target=/workspace,readonly" \
    "$image" scan /workspace --json)
# The PHP expression is intentionally single-quoted for the shell.
# shellcheck disable=SC2016
project_id=$(printf '%s' "$scan" | php -r '$v=json_decode(stream_get_contents(STDIN), true, 512, JSON_THROW_ON_ERROR); echo $v["project_id"];')
# The snapshots at each step, written to files rather than captured in a
# variable, so a failing command stops the script under `set -e`.
snapshots() {
    docker run --rm --mount "type=volume,source=$volume,target=/data" \
        "$image" list-snapshots "$project_id" --json > "$listings/$1.json"
}
snapshots before
docker run --rm --mount "type=volume,source=$volume,target=/data" \
    "$image" maintain-database backup --backup-name=pre-upgrade.sqlite --execute --json >/dev/null
docker run --rm --network none \
    --mount "type=volume,source=$volume,target=/data" \
    --mount "type=volume,source=$source_volume,target=/workspace,readonly" \
    "$image" scan /workspace --mode=full --json >/dev/null
snapshots upgraded
docker run --rm --entrypoint sh --mount "type=volume,source=$volume,target=/data" \
    "$image" -c 'cp /data/backups/pre-upgrade.sqlite /data/knossos.sqlite'
docker run --rm --mount "type=volume,source=$volume,target=/data" \
    "$image" architecture-summary "$project_id" --json >/dev/null
# Exit 0 from the copy and the summary says the database opens, not that it is
# the backup. The snapshot listings say that: the upgrade added one, and the
# restored database holds exactly the ones the backup did.
snapshots restored
php "$(dirname -- "$0")/lifecycle-restore-check.php" "$listings/before.json" "$listings/upgraded.json" "$listings/restored.json"

echo "Clean install, idempotent upgrade scan, and verified backup rollback passed."
